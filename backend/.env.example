DATABASE_URL=postgresql+asyncpg://postgres:postgres@db:5432/legalassist
SECRET_KEY=change-me-to-a-random-secret-key
# Модель: Google Gemini.
# Вариант A — Vertex AI (сервис-аккаунт): оставь AI_API_KEY пустым и задай VERTEX_*.
# Вариант B — API-ключ Gemini (AI Studio): задай AI_API_KEY, VERTEX_* можно не указывать.
AI_API_KEY=
AI_MODEL=gemini-2.5-flash
VERTEX_AI_PROJECT=your-gcp-project-id
VERTEX_AI_LOCATION=us-central1
GOOGLE_APPLICATION_CREDENTIALS=/app/credentials.json
EMBEDDING_MODEL=intfloat/multilingual-e5-base
STORAGE_DIR=./storage
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# AI-реранжирование подобранных норм (улучшает релевантность, +1 вызов модели)
ENABLE_AI_RERANK=true
AI_RERANK_CANDIDATES=40
AI_RERANK_MIN_KEEP=6

# L1 Domain Router (Фаза 3): классифицирует дело в домен и ограничивает подбор
# норм пулом источников домена (убирает кросс-доменные «магниты»). +1 вызов модели.
# На ошибке классификатора — fallback к полному поиску по базе.
ENABLE_DOMAIN_ROUTER=true
